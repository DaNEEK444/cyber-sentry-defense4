# Cyber Sentry Defense Custom Suricata Rules

alert dns any any -> any any (
    msg:"CSD DNS Query for Suspicious Domain";
    dns.query;
    content:".top";
    nocase;
    classtype:trojan-activity;
    sid:1000001;
    rev:1;
)

alert http any any -> any any (
    msg:"CSD Suspicious User-Agent Detected";
    http.user_agent;
    content:"curl";
    nocase;
    classtype:bad-unknown;
    sid:1000002;
    rev:1;
)

alert tls any any -> any any (
    msg:"CSD TLS Certificate with Short Validity";
    tls.cert_valid;
    threshold:type both, track by_src, count 3, seconds 60;
    classtype:bad-unknown;
    sid:1000003;
    rev:1;
)
